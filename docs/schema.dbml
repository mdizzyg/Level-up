Table users {
  id bigint [pk, increment]
  name varchar(100) [not null]
  created_at timestamp [not null]
}

Table categories {
  id bigint [pk, increment]
  user_id bigint
  name varchar(100) [not null]
  description text
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
}

Table weekly_goals {
  id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(150) [not null]
  start_date date [not null]
  end_date date [not null]
  target_profit decimal(12,2) [not null]
  initial_capital decimal(12,2) [not null]
  comment text
  created_at timestamp [not null]
}

Table weekly_goal_categories {
  id bigint [pk, increment]
  weekly_goal_id bigint [not null]
  category_id bigint [not null]
  target_profit decimal(12,2)
}

Table tasks {
  id bigint [pk, increment]
  user_id bigint [not null]
  weekly_goal_id bigint
  category_id bigint
  name varchar(255) [not null]
  task_date date [not null]
  status varchar(30) [not null]
  priority varchar(20)
  comment text
  created_at timestamp [not null]
}

Table deals {
  id bigint [pk, increment]
  user_id bigint [not null]
  weekly_goal_id bigint
  category_id bigint [not null]
  name varchar(255) [not null]
  purchase_date date
  sale_date date
  purchase_price decimal(12,2)
  sale_price decimal(12,2)
  expenses decimal(12,2) [default: 0]
  profit decimal(12,2)
  roi decimal(8,2)
  status varchar(30) [not null]
  comment text
  created_at timestamp [not null]
}

Table capital_transactions {
  id bigint [pk, increment]
  user_id bigint [not null]
  category_id bigint
  deal_id bigint
  transaction_type varchar(30) [not null]
  amount decimal(12,2) [not null]
  transaction_date timestamp [not null]
  comment text
}

Table capital_history {
  id bigint [pk, increment]
  user_id bigint [not null]
  total_capital decimal(12,2) [not null]
  free_capital decimal(12,2) [not null]
  capital_in_use decimal(12,2) [not null]
  recorded_at timestamp [not null]
}

/* Relationships */

Ref: categories.user_id > users.id

Ref: weekly_goals.user_id > users.id

Ref: weekly_goal_categories.weekly_goal_id > weekly_goals.id
Ref: weekly_goal_categories.category_id > categories.id

Ref: tasks.user_id > users.id
Ref: tasks.weekly_goal_id > weekly_goals.id
Ref: tasks.category_id > categories.id

Ref: deals.user_id > users.id
Ref: deals.weekly_goal_id > weekly_goals.id
Ref: deals.category_id > categories.id

Ref: capital_transactions.user_id > users.id
Ref: capital_transactions.category_id > categories.id
Ref: capital_transactions.deal_id > deals.id

Ref: capital_history.user_id > users.id